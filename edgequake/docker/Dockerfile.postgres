# EdgeQuake PostgreSQL — pgvector + contrib FTS extensions
#
# Graph storage uses PostgresRelationalGraphStorage (no Apache AGE required).
# SSOT extension pins: edgequake/docker/extension-pins.sh (SPEC-042 / Issue #161)
#   PostgreSQL 16 (bookworm)
#   pgvector     v0.8.3  — https://pgxn.org/dist/vector
#   contrib      pg_trgm, btree_gin, uuid-ossp (postgresql-contrib-16)

FROM postgres:16-bookworm

ARG PGVECTOR_VERSION=v0.8.3

LABEL org.edgequake.postgres.version="16-bookworm" \
      org.edgequake.pgvector.version="0.8.3" \
      org.edgequake.extensions="vector,pg_trgm,btree_gin,uuid-ossp"

# Build pgvector; keep runtime contrib packages for FTS/trigram indexes.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    postgresql-contrib-16 \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# pgvector — OPTFLAGS="" avoids SIGILL on Docker Desktop VMs without SVE
RUN set -eux; \
    cd /tmp; \
    git clone --depth 1 --branch "${PGVECTOR_VERSION}" https://github.com/pgvector/pgvector.git; \
    cd pgvector; \
    make OPTFLAGS=""; \
    make install; \
    rm -rf /tmp/pgvector

# Drop build toolchain only — keep postgresql-contrib-16 at runtime.
RUN apt-get purge -y --auto-remove \
    build-essential \
    postgresql-server-dev-16 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Fail the image build if extensions are missing or wrong version.
RUN set -eux; \
    test -f /usr/share/postgresql/16/extension/vector.control; \
    test -f /usr/share/postgresql/16/extension/pg_trgm.control; \
    test -f /usr/share/postgresql/16/extension/btree_gin.control; \
    test -f /usr/share/postgresql/16/extension/uuid-ossp.control; \
    grep -q "default_version = '0.8.3'" /usr/share/postgresql/16/extension/vector.control

EXPOSE 5432
CMD ["postgres"]
